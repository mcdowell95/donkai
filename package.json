{
  "name": "donkai",
  "version": "0.1.0",
  "private": true,
  "description": "Donkai — donkey-work AI. Picks up Linear tickets and drives Claude Code workers through them end-to-end.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "orchestrator": "tsx src/orchestrator/main.ts",
    "dashboard": "tsx src/dashboard/main.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@hono/mcp": "^0.3.1",
    "@hono/node-server": "^1.13.0",
    "@linear/sdk": "^31.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
