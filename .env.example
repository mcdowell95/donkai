# --- Required ---
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx
LINEAR_TEAM_KEYS=ENG,DATA              # comma-separated Linear team keys (e.g. team prefix before issue number)

# --- Ticket pickup filter ---
# Default (empty): pick up tickets in STATE_READY that are assigned to you.
# When set: pick up tickets in STATE_READY that carry this label (assignee ignored).
# Use this if multiple people share the same Linear user, or you want any
# unassigned-but-labelled ticket to be eligible.
LINEAR_PICKUP_LABEL=

# --- Workflow state names (must match exactly what you've configured in Linear) ---
STATE_READY=Ready for Claude
STATE_IN_PROGRESS=In Progress
STATE_WAITING=Waiting for human
STATE_REVIEW=Review
STATE_DONE=Done

# --- Polling ---
POLL_INTERVAL_SECS=60

# --- Workspaces / data ---
DONKAI_WORKSPACE_ROOT=~/donkai-workers
DONKAI_DB_PATH=~/donkai-workers/donkai.sqlite

# --- Worker context file (copy worker-CLAUDE.md.example to worker-CLAUDE.md and customise) ---
WORKER_CLAUDE_MD_PATH=./worker-CLAUDE.md

# --- Worker MCP servers ---
# Optional. Path to an MCP JSON file (same format as Claude Code's .mcp.json)
# that gets copied into every worker workspace as `.mcp.json` and auto-loaded
# by the Agent SDK. Servers are auto-trusted via enableAllProjectMcpServers;
# all `mcp__*` tools are allowlisted so workers can call them without prompts.
# Skip this var (or leave the file absent) to run workers without MCPs.
WORKER_MCP_JSON_PATH=./worker-mcp.json

# --- Claude Agent SDK ---
# Leave empty to reuse the local `claude` CLI's subscription auth (recommended for Pro/Max users).
# Set ANTHROPIC_API_KEY only if you want pay-per-token billing instead.
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7              # or claude-sonnet-4-6, claude-haiku-4-5
WORKER_TIMEOUT_SECS=1800                  # 30 min hard cap per CC invocation

# --- Tier 2 classification (BLOCKED reasons containing any keyword route to Linear comment, not dashboard) ---
TIER2_KEYWORDS=api key,access,permission,provision,credentials,secret,infrastructure,deploy

# --- Concurrency ---
# parallel              — run up to MAX_CONCURRENT_WORKERS at once (CTC default)
# sequential            — one worker globally; queue the rest
# sequential_per_repo   — parallel across repos, serial within a repo
CONCURRENCY_MODE=parallel
MAX_CONCURRENT_WORKERS=3

# How to infer "repo" for sequential_per_repo. One of: label_prefix | project | first_line
# label_prefix: ticket label starting with "repo:" (e.g. "repo:data-platform")
# project: Linear project name maps to repo
# first_line: first non-empty line of description, if it matches /^Repo:\s*(\S+)/
REPO_INFERENCE=label_prefix

# --- Autonomy (only consulted in WORKFLOW_MODE=direct_main) ---
# review_only           — open PR, wait for green, human merges (CTC default)
# auto_merge_on_green   — open PR, wait for green + guards pass, squash merge, close ticket
# full_yolo             — auto_merge_on_green + retry failed CI up to AUTO_MERGE_CI_RETRIES times
AUTONOMY_LEVEL=review_only
AUTO_MERGE_REPOS_ALLOWLIST=                   # empty = nothing eligible
AUTO_MERGE_MAX_FILES_CHANGED=20
AUTO_MERGE_MAX_LINES_CHANGED=500
AUTO_MERGE_REQUIRE_LABEL=claude-auto
AUTO_MERGE_BLOCK_PATHS=infra/**,terraform/**,.github/**,**/secrets*,**/.env*
AUTO_MERGE_BLOCK_KEYWORDS=migration,schema,drop,delete,credential,secret,password,token
AUTO_MERGE_CI_RETRIES=3

# --- Workflow ---
# direct_main      — workers branch from main, PR into main (existing behavior)
# staging_promote  — workers branch from DEV_BRANCH, PR into DEV_BRANCH. Donkai
#                    squash-merges into DEV_BRANCH (no guards), waits for the named
#                    GHA check on the merge SHA, triggers a Coolify dev redeploy,
#                    then appends the ticket to a single rolling DEV_BRANCH→MAIN_BRANCH
#                    PR. When a human merges that PR, Donkai waits for the main GHA,
#                    triggers a Coolify prod redeploy, then closes the listed tickets.
WORKFLOW_MODE=direct_main
DEV_BRANCH=dev
MAIN_BRANCH=main
DEV_DEPLOY_CHECK=build-and-push           # GHA check that builds + pushes the dev image
MAIN_DEPLOY_CHECK=build-and-push          # GHA check on main (defaults to DEV_DEPLOY_CHECK if unset)
DEV_DEPLOY_POLL_SECS=30                   # currently informational — orchestrator polls at POLL_INTERVAL_SECS

# --- Coolify (required in staging_promote mode for redeploys) ---
COOLIFY_BASE_URL=                         # e.g. https://coolify.example.com (no trailing slash)
COOLIFY_API_TOKEN=                        # API token with deploy permissions
COOLIFY_DEPLOY_TIMEOUT_SECS=1200          # max wait for a Coolify redeploy to finish before failing the ticket
# Per-repo app UUIDs. Repo name uppercased with `-`/`.`/`/` → `_`.
# For repo "canter-app":
# COOLIFY_APP_CANTER_APP_DEV=00000000-0000-0000-0000-000000000000
# COOLIFY_APP_CANTER_APP_PROD=00000000-0000-0000-0000-000000000000

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8346
# DASHBOARD_TOKEN=changeme        # if set, basic-auth password
DASHBOARD_SUBTITLE=
